{
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://qr-code-smart-cariola.onrender.com/api/:path*" },
    { "source": "/r/:path*",   "destination": "https://qr-code-smart-cariola.onrender.com/r/:path*" },
    { "source": "/d/:path*",   "destination": "https://qr-code-smart-cariola.onrender.com/d/:path*" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}